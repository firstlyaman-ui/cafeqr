{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/c/:slug/t/:table", "destination": "/c/%5Bslug%5D/t/%5Btable%5D" },
    { "source": "/order/:id/invoice", "destination": "/order/%5Bid%5D/invoice" },
    { "source": "/order/:id", "destination": "/order/%5Bid%5D" },
    { "source": "/confirmation/:id", "destination": "/confirmation/%5Bid%5D" },
    { "source": "/t/:table", "destination": "/t/%5Btable%5D" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
